# MySQL connection string used by Prisma
DATABASE_URL="mysql://root:admin%40123@localhost:3306/collab_board"

# HTTP/Socket.IO server port
PORT=4000

# Allowed CORS origin for REST + Socket.IO (the frontend URL)
CLIENT_ORIGIN="http://localhost:5173"

# Stable id of the single default board created by the seed script
DEFAULT_BOARD_ID="11111111-1111-1111-1111-111111111111"

# Secret used to sign JWT auth tokens (use a long random value in production)
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
